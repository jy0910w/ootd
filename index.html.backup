<!DOCTYPE html>
<html lang="zh-TW" class="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>OOTD — Outfit of the Day</title>
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Design System -->
  <link rel="stylesheet" href="design-tokens.css" />
  
  <!-- Fonts: Geist Sans (primary) with Inter fallback -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              50:  '#ECFDF7',
              100: '#D1FAE5',
              200: '#A7F3D0',
              300: '#6EE7B7',
              400: '#34D399',
              500: '#00D4AA',  /* Teal primary */
              600: '#00B894',
              700: '#0D9B7E',
              800: '#047857',
              900: '#065F46',
            },
            accent: {
              DEFAULT: '#FFB347', /* Orange */
              hover: '#FF9E1F',
              active: '#F97316',
            },
          },
          fontFamily: {
            sans: ['Inter', 'SF Pro Display', 'SF Pro Text', 'system-ui', 'sans-serif'],
            display: ['Inter', 'SF Pro Display', 'SF Pro Text', 'system-ui', 'sans-serif'],
          },
          letterSpacing: {
            tight: '-0.02em',
            wide: '0.02em',
            wider: '0.05em',
          },
          borderRadius: {
            sm: '6px',
            DEFAULT: '8px',
            md: '8px',
            lg: '12px',
            xl: '16px',
            '2xl': '24px',
          },
        },
      },
    }
  </script>
  <style>
    * { box-sizing: border-box; }
    body { 
      font-family: var(--font-primary); 
      background: var(--bg-base); 
      color: var(--text-primary); 
      transition: background-color 0.3s ease, color 0.3s ease;
    }

    /* Grain overlay - subtle texture (light mode only) */
    :root.light body::before {
      content: '';
      position: fixed; inset: 0; z-index: 999; pointer-events: none;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
      opacity: 0.15;
    }

    /* Scrollbar */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: var(--bg-subtle); }
    ::-webkit-scrollbar-thumb { 
      background: var(--color-brand-500); 
      border-radius: var(--radius-sm); 
    }
    ::-webkit-scrollbar-thumb:hover { background: var(--color-brand-600); }

    /* Page transitions */
    .page { display: none !important; }
    .page.active { display: block !important; }
    .page.active.flex-page { display: flex !important; }
    .page.active.flex-col-page { display: flex !important; flex-direction: column !important; }

    /* Masonry grid */
    .masonry {
      columns: 2;
      column-gap: 12px;
    }
    @media (min-width: 768px) { .masonry { columns: 3; column-gap: 16px; } }
    @media (min-width: 1280px) { .masonry { columns: 4; column-gap: 20px; } }
    .masonry-item { break-inside: avoid; margin-bottom: 12px; }
    @media (min-width: 768px) { .masonry-item { margin-bottom: 16px; } }

    /* Card hover */
    .item-card { 
      transition: transform var(--duration-slow) var(--ease-spring),
                  box-shadow var(--duration-slow) var(--ease-out); 
      box-shadow: var(--shadow-sm);
    }
    .item-card:hover { 
      transform: translateY(-4px); 
      box-shadow: var(--shadow-lg);
    }
    .item-card:hover .item-overlay { opacity: 1; }
    .item-overlay { opacity: 0; transition: opacity 0.25s ease; }

    /* Button states */
    .btn-primary {
      background: var(--color-brand-500);
      color: white;
      transition: background var(--duration-fast) var(--ease-out), 
                  transform var(--duration-fast) var(--ease-out), 
                  box-shadow var(--duration-base) var(--ease-out);
    }
    .btn-primary:hover { 
      background: var(--color-brand-600); 
      box-shadow: var(--shadow-md); 
    }
    .btn-primary:active { transform: scale(0.98); }
    .btn-primary:focus-visible { 
      outline: 2px solid var(--color-brand-500); 
      outline-offset: 2px; 
    }

    .btn-ghost {
      border: 1px solid var(--border);
      color: var(--text-primary);
      background: transparent;
      transition: border-color var(--duration-base) var(--ease-out), 
                  background var(--duration-base) var(--ease-out);
    }
    .btn-ghost:hover { 
      border-color: var(--color-brand-500); 
      background: var(--bg-subtle); 
    }
    .btn-ghost:active { background: var(--bg-elevated); }
    .btn-ghost:focus-visible { 
      outline: 2px solid var(--border-focus); 
      outline-offset: 2px; 
    }

    /* Nav link */
    .nav-link {
      position: relative;
      color: var(--text-tertiary);
      transition: color var(--duration-base) var(--ease-out);
      font-family: var(--font-primary);
      font-size: var(--text-xs);
      font-weight: var(--font-medium);
      letter-spacing: var(--tracking-wider);
      text-transform: uppercase;
    }
    .nav-link::after {
      content: '';
      position: absolute; bottom: -2px; left: 0; right: 0;
      height: 2px; background: var(--color-brand-500);
      transform: scaleX(0); 
      transition: transform 0.25s var(--ease-out);
    }
    .nav-link:hover { color: var(--text-primary); }
    .nav-link:hover::after { transform: scaleX(1); }
    .nav-link.active { color: var(--text-primary); font-weight: var(--font-semibold); }
    .nav-link.active::after { transform: scaleX(1); }

    /* Input styles */
    .field {
      background: var(--input-bg);
      border: 1px solid var(--input-border);
      color: var(--text-primary);
      transition: border-color var(--duration-base) var(--ease-out), 
                  background var(--duration-base) var(--ease-out);
    }
    .field::placeholder { color: var(--text-tertiary); }
    .field:focus { 
      outline: none; 
      border-color: var(--border-focus); 
      box-shadow: 0 0 0 3px rgba(0, 212, 170, 0.1);
    }

    /* Upload drop zone */
    .dropzone {
      border: 1px dashed var(--border);
      transition: border-color var(--duration-base) var(--ease-out), 
                  background var(--duration-base) var(--ease-out);
    }
    .dropzone:hover, .dropzone.drag-over {
      border-color: var(--color-brand-500);
      background: var(--color-brand-50);
    }

    /* Modal */
    .modal-backdrop {
      background: var(--bg-overlay);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }

    /* Recommendation card */
    .rec-card {
      transition: transform var(--duration-slow) var(--ease-spring), 
                  box-shadow var(--duration-slow) var(--ease-out);
      box-shadow: var(--shadow-sm);
    }
    .rec-card:hover { 
      transform: translateY(-6px); 
      box-shadow: var(--shadow-xl); 
    }

    /* Outfit card */
    .outfit-card { 
      transition: transform var(--duration-slow) var(--ease-spring),
                  box-shadow var(--duration-slow) var(--ease-out);
      box-shadow: var(--shadow-sm);
    }
    .outfit-card:hover { 
      transform: scale(1.02); 
      box-shadow: var(--shadow-lg);
    }
    .outfit-card:hover .outfit-overlay { opacity: 1; }
    .outfit-overlay { opacity: 0; transition: opacity var(--duration-slow) ease; }

    /* Composer panel item */
    .composer-item {
      transition: transform var(--duration-base) var(--ease-out), 
                  box-shadow var(--duration-base) var(--ease-out), 
                  border-color var(--duration-base) var(--ease-out);
    }
    .composer-item:hover { 
      transform: translateY(-2px); 
      box-shadow: var(--shadow-md); 
    }
    .composer-item.selected { 
      border-color: var(--color-brand-500); 
      box-shadow: 0 0 0 2px var(--color-brand-500); 
    }

    /* Divider */
    .hairline { border-color: var(--border-subtle); }

    /* Tag pill */
    .tag-pill {
      background: var(--tag-bg);
      border: 1px solid var(--tag-border);
      color: var(--tag-text);
      font-size: var(--text-xs);
      font-weight: var(--font-medium);
      letter-spacing: var(--tracking-wide);
      text-transform: uppercase;
      padding: 4px 10px;
      border-radius: var(--radius-full);
    }

    /* Step indicator */
    .step-dot {
      width: 8px; height: 8px; 
      border-radius: 50%;
      background: var(--border);
      transition: background var(--duration-base) var(--ease-out), 
                  transform var(--duration-base) var(--ease-out);
    }
    .step-dot.active { 
      background: var(--color-brand-500); 
      transform: scale(1.5); 
    }
    .step-dot.done { 
      background: var(--color-brand-300); 
    }
  </style>
  
  <!-- Theme Switcher Script -->
  <script src="theme-switcher.js"></script>
</head>
<body>

<!-- ═══════════════════════════════════════════════════
     NAVIGATION (共用)
════════════════════════════════════════════════════ -->
<nav id="main-nav" class="hidden fixed top-0 inset-x-0 z-50 px-6 md:px-10" style="background: var(--bg-base); opacity: 0.95; backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border-bottom: 1px solid var(--border-subtle); box-shadow: var(--shadow-sm);">
  <div class="max-w-screen-xl mx-auto flex items-center justify-between h-16">
    <!-- Logo -->
    <button onclick="showPage('wardrobe')" class="font-display text-xl font-semibold tracking-tight hover:text-brand-500 transition-colors duration-200" style="color: var(--text-primary);">
      OOTD
    </button>
    <!-- Links -->
    <div class="flex items-center gap-8">
      <button onclick="showPage('wardrobe')" class="nav-link" id="nav-wardrobe">衣櫃</button>
      <button onclick="showPage('outfits')" class="nav-link" id="nav-outfits">穿搭</button>
      <button onclick="showPage('recommendations')" class="nav-link" id="nav-recommendations">推薦</button>
    </div>
    <!-- Right side: Theme toggle + Avatar -->
    <div class="flex items-center gap-4">
      <!-- Theme Toggle Button -->
      <button 
        id="theme-toggle" 
        class="w-9 h-9 rounded-lg flex items-center justify-center transition-colors duration-200 hover:bg-brand-50 dark:hover:bg-brand-900"
        style="background: var(--bg-subtle); color: var(--text-secondary);"
        aria-label="切換主題">
        <span class="light-icon" style="font-size: 18px;">🌙</span>
        <span class="dark-icon" style="font-size: 18px; display: none;">☀️</span>
      </button>
      <!-- Avatar -->
      <button onclick="showPage('login')" class="w-9 h-9 rounded-full bg-brand-500 flex items-center justify-center text-sm text-white font-medium hover:bg-brand-600 transition-colors duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand-500 focus-visible:outline-offset-2">
        U
      </button>
    </div>
  </div>
</nav>


<!-- ═══════════════════════════════════════════════════
     PAGE: LOGIN
════════════════════════════════════════════════════ -->
<div id="page-login" class="page active flex-page min-h-screen" style="flex-direction:row; background: var(--bg-base);">
  <!-- Left: image -->
  <div class="hidden lg:block lg:w-1/2 relative overflow-hidden" style="background: var(--color-brand-50);">
    <img src="https://placehold.co/900x1080/ECFDF7/00D4AA?text=." alt="" class="absolute inset-0 w-full h-full object-cover opacity-40" style="mix-blend-mode: multiply;" />
    <div class="absolute inset-0" style="background: linear-gradient(135deg, var(--color-brand-100) 0%, var(--color-brand-200) 100%); opacity: 0.7;"></div>
    <!-- Editorial overlay text -->
    <div class="absolute bottom-12 left-10 right-10">
      <p class="font-display text-6xl font-semibold leading-tight tracking-tight opacity-90" style="color: var(--color-brand-900);">
        Your wardrobe,<br/>curated.
      </p>
      <p class="mt-4 text-sm tracking-wider opacity-60 uppercase font-medium" style="color: var(--color-brand-700);">Outfit of the Day Platform</p>
    </div>
  </div>

  <!-- Right: form -->
  <div class="w-full lg:w-1/2 flex items-center justify-center px-8 md:px-16 py-16" style="background: var(--bg-base);">
    <div class="w-full max-w-sm">
      <!-- Mobile logo -->
      <p class="font-display text-3xl font-semibold tracking-tight mb-2 lg:hidden" style="color: var(--text-primary);">OOTD</p>
      <p class="text-xs tracking-wider opacity-40 uppercase mb-12 lg:hidden" style="color: var(--text-secondary);">Outfit of the Day</p>

      <h1 class="font-display text-4xl font-semibold tracking-tight mb-2" style="color: var(--text-primary);">歡迎回來</h1>
      <p class="text-sm tracking-wide mb-8" style="color: var(--text-secondary);">登入你的衣櫃</p>

      <form onsubmit="handleLogin(event)" class="space-y-5">
        <div>
          <label class="block text-xs tracking-wider uppercase mb-2 font-medium" style="color: var(--text-secondary);">電子信箱</label>
          <input type="email" placeholder="your@email.com" class="field w-full h-12 px-4 text-base" style="border-radius: var(--radius-md);" />
        </div>
        <div>
          <label class="block text-xs tracking-wider uppercase mb-2 font-medium" style="color: var(--text-secondary);">密碼</label>
          <input type="password" placeholder="••••••••" class="field w-full h-12 px-4 text-base" style="border-radius: var(--radius-md);" />
        </div>
        <button type="submit" class="btn-primary w-full h-12 text-base font-semibold tracking-wide uppercase mt-3" style="border-radius: var(--radius-md);">
          登入
        </button>
      </form>

      <div class="mt-8 pt-8 border-t hairline flex items-center justify-between">
        <p class="text-sm" style="color: var(--text-tertiary);">還沒有帳號？</p>
        <button class="text-sm font-medium transition-colors duration-200 tracking-wide focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2" style="color: var(--color-brand-500); border-radius: var(--radius-sm);">
          立即註冊
        </button>
      </div>
    </div>
  </div>
</div>


<!-- ═══════════════════════════════════════════════════
     PAGE: WARDROBE
════════════════════════════════════════════════════ -->
<div id="page-wardrobe" class="page pt-16 min-h-screen" style="background: var(--bg-base);">
  <div class="max-w-screen-xl mx-auto px-4 md:px-8 lg:px-10">

    <!-- Header -->
    <div class="flex items-end justify-between py-8 border-b hairline mb-6">
      <div>
        <p class="text-xs tracking-wider uppercase mb-2 font-medium" style="color: var(--text-tertiary);">My Collection</p>
        <h1 class="font-display text-5xl md:text-6xl font-semibold tracking-tight" style="line-height:1.1; color: var(--text-primary);">衣櫃</h1>
      </div>
      <button onclick="openUploadModal()" class="btn-primary h-11 px-6 text-sm tracking-wide uppercase font-semibold flex items-center gap-2" style="border-radius: var(--radius-md);">
        <span style="font-size:18px; line-height:1;">+</span>
        新增單品
      </button>
    </div>

    <!-- Filter bar -->
    <div class="flex items-center gap-3 pb-6 overflow-x-auto" style="scrollbar-width: none;">
      <button class="shrink-0 h-9 px-5 text-xs tracking-wide uppercase btn-primary font-medium" style="border-radius: var(--radius-full);">全部</button>
      <button class="shrink-0 h-9 px-5 text-xs tracking-wide uppercase btn-ghost font-medium" style="border-radius: var(--radius-full);">上衣</button>
      <button class="shrink-0 h-9 px-5 text-xs tracking-wide uppercase btn-ghost font-medium" style="border-radius: var(--radius-full);">下身</button>
      <button class="shrink-0 h-9 px-5 text-xs tracking-wide uppercase btn-ghost font-medium" style="border-radius: var(--radius-full);">外套</button>
      <button class="shrink-0 h-9 px-5 text-xs tracking-wide uppercase btn-ghost font-medium" style="border-radius: var(--radius-full);">鞋履</button>
      <button class="shrink-0 h-9 px-5 text-xs tracking-wide uppercase btn-ghost font-medium" style="border-radius: var(--radius-full);">配件</button>
    </div>

    <!-- Masonry grid -->
    <div class="masonry pb-16">

      <!-- Item cards -->
      <div class="masonry-item">
        <div class="item-card relative rounded overflow-hidden cursor-pointer" style="background:#1a1a17;">
          <img src="https://placehold.co/400x560/1a1a17/2f7a56?text=." alt="白色 Tee" class="w-full block" />
          <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(13,13,11,0.8) 0%, transparent 50%);"></div>
          <div class="item-overlay absolute inset-0 flex flex-col justify-between p-4" style="background: rgba(13,13,11,0.6);">
            <div class="flex justify-end gap-2">
              <button class="w-8 h-8 rounded flex items-center justify-center btn-ghost text-xs">✏</button>
              <button class="w-8 h-8 rounded flex items-center justify-center btn-ghost text-xs">🗑</button>
            </div>
            <button class="btn-primary w-full h-9 rounded text-xs tracking-widest uppercase">加入穿搭</button>
          </div>
          <div class="absolute bottom-0 left-0 right-0 p-3 pointer-events-none">
            <p class="text-xs text-cream font-medium">白色 Tee</p>
            <div class="flex gap-1 mt-1">
              <span class="tag-pill px-2 py-0.5 rounded-full">上衣</span>
              <span class="tag-pill px-2 py-0.5 rounded-full">白色</span>
            </div>
          </div>
        </div>
      </div>

      <div class="masonry-item">
        <div class="item-card relative rounded overflow-hidden cursor-pointer" style="background:#1a1a17;">
          <img src="https://placehold.co/400x680/13200f/2f7a56?text=." alt="牛仔外套" class="w-full block" />
          <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(13,13,11,0.8) 0%, transparent 50%);"></div>
          <div class="item-overlay absolute inset-0 flex flex-col justify-between p-4" style="background: rgba(13,13,11,0.6);">
            <div class="flex justify-end gap-2">
              <button class="w-8 h-8 rounded flex items-center justify-center btn-ghost text-xs">✏</button>
              <button class="w-8 h-8 rounded flex items-center justify-center btn-ghost text-xs">🗑</button>
            </div>
            <button class="btn-primary w-full h-9 rounded text-xs tracking-widest uppercase">加入穿搭</button>
          </div>
          <div class="absolute bottom-0 left-0 right-0 p-3 pointer-events-none">
            <p class="text-xs text-cream font-medium">牛仔外套</p>
            <div class="flex gap-1 mt-1">
              <span class="tag-pill px-2 py-0.5 rounded-full">外套</span>
              <span class="tag-pill px-2 py-0.5 rounded-full">藍色</span>
            </div>
          </div>
        </div>
      </div>

      <div class="masonry-item">
        <div class="item-card relative rounded overflow-hidden cursor-pointer" style="background:#1a1a17;">
          <img src="https://placehold.co/400x500/0f0f0d/2f7a56?text=." alt="黑色長褲" class="w-full block" />
          <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(13,13,11,0.8) 0%, transparent 50%);"></div>
          <div class="item-overlay absolute inset-0 flex flex-col justify-between p-4" style="background: rgba(13,13,11,0.6);">
            <div class="flex justify-end gap-2">
              <button class="w-8 h-8 rounded flex items-center justify-center btn-ghost text-xs">✏</button>
              <button class="w-8 h-8 rounded flex items-center justify-center btn-ghost text-xs">🗑</button>
            </div>
            <button class="btn-primary w-full h-9 rounded text-xs tracking-widest uppercase">加入穿搭</button>
          </div>
          <div class="absolute bottom-0 left-0 right-0 p-3 pointer-events-none">
            <p class="text-xs text-cream font-medium">黑色長褲</p>
            <div class="flex gap-1 mt-1">
              <span class="tag-pill px-2 py-0.5 rounded-full">下身</span>
              <span class="tag-pill px-2 py-0.5 rounded-full">黑色</span>
            </div>
          </div>
        </div>
      </div>

      <div class="masonry-item">
        <div class="item-card relative rounded overflow-hidden cursor-pointer" style="background:#1a1a17;">
          <img src="https://placehold.co/400x620/1a1412/2f7a56?text=." alt="米色風衣" class="w-full block" />
          <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(13,13,11,0.8) 0%, transparent 50%);"></div>
          <div class="item-overlay absolute inset-0 flex flex-col justify-between p-4" style="background: rgba(13,13,11,0.6);">
            <div class="flex justify-end gap-2">
              <button class="w-8 h-8 rounded flex items-center justify-center btn-ghost text-xs">✏</button>
              <button class="w-8 h-8 rounded flex items-center justify-center btn-ghost text-xs">🗑</button>
            </div>
            <button class="btn-primary w-full h-9 rounded text-xs tracking-widest uppercase">加入穿搭</button>
          </div>
          <div class="absolute bottom-0 left-0 right-0 p-3 pointer-events-none">
            <p class="text-xs text-cream font-medium">米色風衣</p>
            <div class="flex gap-1 mt-1">
              <span class="tag-pill px-2 py-0.5 rounded-full">外套</span>
              <span class="tag-pill px-2 py-0.5 rounded-full">米色</span>
            </div>
          </div>
        </div>
      </div>

      <div class="masonry-item">
        <div class="item-card relative rounded overflow-hidden cursor-pointer" style="background:#1a1a17;">
          <img src="https://placehold.co/400x460/111811/2f7a56?text=." alt="森林綠針織" class="w-full block" />
          <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(13,13,11,0.8) 0%, transparent 50%);"></div>
          <div class="item-overlay absolute inset-0 flex flex-col justify-between p-4" style="background: rgba(13,13,11,0.6);">
            <div class="flex justify-end gap-2">
              <button class="w-8 h-8 rounded flex items-center justify-center btn-ghost text-xs">✏</button>
              <button class="w-8 h-8 rounded flex items-center justify-center btn-ghost text-xs">🗑</button>
            </div>
            <button class="btn-primary w-full h-9 rounded text-xs tracking-widest uppercase">加入穿搭</button>
          </div>
          <div class="absolute bottom-0 left-0 right-0 p-3 pointer-events-none">
