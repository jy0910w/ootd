<div id="page-composer" class="page flex-col-page pt-14 min-h-screen">
  <div class="max-w-screen-xl mx-auto w-full px-4 md:px-8 lg:px-10 flex-1 flex flex-col">

    <!-- Header -->
    <div class="flex items-center justify-between py-6 border-b hairline mb-0">
      <div>
        <button onclick="showPage('outfits')" class="text-xs tracking-widest text-cream opacity-30 uppercase mb-1 hover:opacity-60 transition-opacity duration-200 flex items-center gap-1">
          ← 返回穿搭
        </button>
        <h1 class="font-display text-3xl font-light tracking-tighter text-cream mt-1">組合新穿搭</h1>
      </div>
      <div class="flex gap-3">
        <button class="btn-ghost h-10 px-5 rounded text-xs tracking-widest uppercase">預覽</button>
        <button class="btn-primary h-10 px-5 rounded text-xs tracking-widest uppercase">儲存</button>
      </div>
    </div>

    <!-- Two-panel layout -->
    <div class="flex-1 flex gap-0 overflow-hidden" style="min-height: calc(100vh - 200px);">

      <!-- Left: wardrobe panel -->
      <div class="w-64 md:w-72 shrink-0 border-r hairline flex flex-col" style="background: rgba(26,26,23,0.6);">
        <div class="p-4 border-b hairline">
          <p class="text-xs tracking-widest text-cream opacity-30 uppercase mb-3">衣櫃單品</p>
          <!-- Mini filter -->
          <div class="flex flex-wrap gap-1.5">
            <button class="h-6 px-3 rounded-full text-xs btn-primary" style="font-size:9px; letter-spacing:0.05em;">全部</button>
            <button class="h-6 px-3 rounded-full text-xs btn-ghost" style="font-size:9px; letter-spacing:0.05em;">上衣</button>
            <button class="h-6 px-3 rounded-full text-xs btn-ghost" style="font-size:9px; letter-spacing:0.05em;">下身</button>
            <button class="h-6 px-3 rounded-full text-xs btn-ghost" style="font-size:9px; letter-spacing:0.05em;">外套</button>
          </div>
        </div>
        <!-- Item list -->
        <div class="flex-1 overflow-y-auto p-3 space-y-2" style="scrollbar-width: thin; scrollbar-color: #2f7a56 transparent;">
          <div class="composer-item border border-transparent rounded overflow-hidden cursor-pointer flex gap-2 p-1.5" onclick="toggleComposerItem(this)" style="background: rgba(245,240,235,0.03);">
            <img src="https://placehold.co/56x70/1a1a17/2f7a56?text=." class="w-14 h-16 object-cover rounded shrink-0" />
            <div class="flex-1 min-w-0 py-1">
              <p class="text-xs text-cream font-medium truncate">白色 Tee</p>
              <p class="text-xs text-cream opacity-30 mt-0.5">上衣 · 白色</p>
            </div>
          </div>
          <div class="composer-item border border-transparent rounded overflow-hidden cursor-pointer flex gap-2 p-1.5 selected" onclick="toggleComposerItem(this)" style="background: rgba(245,240,235,0.03);">
            <img src="https://placehold.co/56x70/13200f/2f7a56?text=." class="w-14 h-16 object-cover rounded shrink-0" />
            <div class="flex-1 min-w-0 py-1">
              <p class="text-xs text-cream font-medium truncate">牛仔外套</p>
              <p class="text-xs text-cream opacity-30 mt-0.5">外套 · 藍色</p>
            </div>
          </div>
          <div class="composer-item border border-transparent rounded overflow-hidden cursor-pointer flex gap-2 p-1.5 selected" onclick="toggleComposerItem(this)" style="background: rgba(245,240,235,0.03);">
            <img src="https://placehold.co/56x70/0f0f0d/2f7a56?text=." class="w-14 h-16 object-cover rounded shrink-0" />
            <div class="flex-1 min-w-0 py-1">
