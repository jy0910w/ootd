              <p class="text-xs text-cream opacity-30 mt-0.5">下身 · 黑色</p>
            </div>
          </div>
          <div class="composer-item border border-transparent rounded overflow-hidden cursor-pointer flex gap-2 p-1.5" onclick="toggleComposerItem(this)" style="background: rgba(245,240,235,0.03);">
            <img src="https://placehold.co/56x70/1a1412/2f7a56?text=." class="w-14 h-16 object-cover rounded shrink-0" />
            <div class="flex-1 min-w-0 py-1">
              <p class="text-xs text-cream font-medium truncate">米色風衣</p>
              <p class="text-xs text-cream opacity-30 mt-0.5">外套 · 米色</p>
            </div>
          </div>
          <div class="composer-item border border-transparent rounded overflow-hidden cursor-pointer flex gap-2 p-1.5" onclick="toggleComposerItem(this)" style="background: rgba(245,240,235,0.03);">
            <img src="https://placehold.co/56x70/111811/2f7a56?text=." class="w-14 h-16 object-cover rounded shrink-0" />
            <div class="flex-1 min-w-0 py-1">
              <p class="text-xs text-cream font-medium truncate">森林綠針織</p>
              <p class="text-xs text-cream opacity-30 mt-0.5">上衣 · 綠色</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: canvas -->
      <div class="flex-1 flex flex-col">
        <!-- Canvas area -->
        <div class="flex-1 p-6 flex flex-wrap gap-4 content-start overflow-y-auto relative" style="background-image: radial-gradient(circle, rgba(245,240,235,0.04) 1px, transparent 1px); background-size: 28px 28px;">
          <!-- Selected items shown as cards -->
          <div class="relative rounded overflow-hidden" style="width:140px; height:176px; background:#1a1a17;">
            <img src="https://placehold.co/140x176/13200f/2f7a56?text=." class="w-full h-full object-cover" />
            <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(13,13,11,0.7) 0%, transparent 60%);"></div>
            <p class="absolute bottom-2 left-0 right-0 text-center text-xs text-cream">牛仔外套</p>
            <button class="absolute top-1.5 right-1.5 w-5 h-5 rounded-full flex items-center justify-center text-cream text-xs hover:bg-red-900 transition-colors" style="background:rgba(13,13,11,0.6); font-size:10px;">✕</button>
          </div>
          <div class="relative rounded overflow-hidden" style="width:140px; height:176px; background:#1a1a17;">
            <img src="https://placehold.co/140x176/0f0f0d/2f7a56?text=." class="w-full h-full object-cover" />
            <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(13,13,11,0.7) 0%, transparent 60%);"></div>
            <p class="absolute bottom-2 left-0 right-0 text-center text-xs text-cream">黑色長褲</p>
            <button class="absolute top-1.5 right-1.5 w-5 h-5 rounded-full flex items-center justify-center text-cream text-xs hover:bg-red-900 transition-colors" style="background:rgba(13,13,11,0.6); font-size:10px;">✕</button>
          </div>
          <!-- Empty slot hint -->
          <div class="rounded flex items-center justify-center" style="width:140px; height:176px; border:1px dashed rgba(245,240,235,0.1); background:rgba(245,240,235,0.02);">
            <p class="text-xs text-cream opacity-20 text-center px-3">從左側<br/>選擇單品</p>
          </div>
        </div>

        <!-- Bottom action bar -->
        <div class="border-t hairline p-4 flex items-center justify-between" style="background: rgba(13,13,11,0.8);">
          <div>
            <p class="text-xs text-cream opacity-30 uppercase tracking-widest mb-1">已選 2 件</p>
            <div class="flex gap-1.5">
              <span class="tag-pill px-2 py-0.5 rounded-full">牛仔外套</span>
              <span class="tag-pill px-2 py-0.5 rounded-full">黑色長褲</span>
            </div>
          </div>
