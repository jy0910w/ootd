    </div>
  </div>
</div>


<!-- ═══════════════════════════════════════════════════
     MODAL: UPLOAD
════════════════════════════════════════════════════ -->
<div id="upload-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="modal-backdrop absolute inset-0" onclick="closeUploadModal()"></div>
  <div class="relative w-full max-w-lg rounded-lg overflow-hidden" style="background:#1a1a17; border:1px solid rgba(245,240,235,0.1); box-shadow: 0 40px 120px rgba(0,0,0,0.7);">

    <!-- Step indicator -->
    <div class="flex items-center justify-between px-6 pt-5 pb-4 border-b hairline">
      <h2 class="font-display text-xl font-light tracking-tight text-cream">新增單品</h2>
      <div class="flex items-center gap-2">
        <div class="step-dot done" id="dot-0"></div>
        <div style="width:20px; height:1px; background:rgba(245,240,235,0.15);"></div>
        <div class="step-dot active" id="dot-1"></div>
        <div style="width:20px; height:1px; background:rgba(245,240,235,0.15);"></div>
        <div class="step-dot" id="dot-2"></div>
        <button onclick="closeUploadModal()" class="ml-4 w-7 h-7 rounded flex items-center justify-center text-cream opacity-30 hover:opacity-60 transition-opacity text-sm">✕</button>
      </div>
    </div>

    <!-- Step 1: Upload -->
    <div id="modal-step-1" class="p-6">
      <p class="text-xs tracking-widest text-cream opacity-30 uppercase mb-4">步驟 1 · 上傳圖片</p>
      <label class="dropzone block rounded-lg p-10 text-center cursor-pointer">
        <input type="file" accept="image/*" class="hidden" onchange="handleFileSelect(event)" />
        <div class="text-3xl mb-3 opacity-30">📷</div>
        <p class="text-sm text-cream opacity-50 mb-1">拖曳圖片或點擊上傳</p>
        <p class="text-xs text-cream opacity-25">支援 JPG、PNG、WEBP、HEIC · 最大 10 MB</p>
      </label>
      <!-- Preview (hidden by default) -->
      <div id="preview-container" class="hidden mt-4 rounded overflow-hidden relative" style="aspect-ratio:4/5; max-height:280px;">
        <img id="preview-img" src="" class="w-full h-full object-cover" />
        <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(13,13,11,0.4) 0%, transparent 60%);"></div>
        <button class="absolute top-2 right-2 btn-ghost w-7 h-7 rounded flex items-center justify-center text-xs" onclick="clearPreview()">✕</button>
      </div>
      <div class="flex justify-end mt-4">
        <button onclick="nextStep(2)" class="btn-primary h-10 px-6 rounded text-xs tracking-widest uppercase">下一步</button>
      </div>
    </div>

    <!-- Step 2: Category (hidden) -->
    <div id="modal-step-2" class="p-6 hidden">
      <p class="text-xs tracking-widest text-cream opacity-30 uppercase mb-4">步驟 2 · 分類資訊</p>
      <div class="space-y-4">
        <div>
          <label class="block text-xs tracking-widest text-cream opacity-40 uppercase mb-2">名稱</label>
          <input type="text" placeholder="例：白色棉質 T-shirt" class="field w-full h-10 px-3 rounded text-sm" />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs tracking-widest text-cream opacity-40 uppercase mb-2">類別</label>
            <select class="field w-full h-10 px-3 rounded text-sm appearance-none">
              <option value="">選擇類別</option>
              <option>上衣</option><option>下身</option><option>外套</option><option>鞋履</option><option>配件</option>
            </select>
          </div>
          <div>
            <label class="block text-xs tracking-widest text-cream opacity-40 uppercase mb-2">顏色</label>
            <select class="field w-full h-10 px-3 rounded text-sm appearance-none">
              <option value="">選擇顏色</option>
              <option>黑色</option><option>白色</option><option>灰色</option><option>米色</option><option>藍色</option><option>綠色</option><option>紅色</option>
            </select>
          </div>
        </div>
        <div>
          <label class="block text-xs tracking-widest text-cream opacity-40 uppercase mb-2">季節</label>
          <div class="flex gap-2 flex-wrap">
            <button class="h-8 px-4 rounded-full text-xs btn-ghost" style="font-size:10px; letter-spacing:0.05em;">春</button>
            <button class="h-8 px-4 rounded-full text-xs btn-ghost" style="font-size:10px; letter-spacing:0.05em;">夏</button>
            <button class="h-8 px-4 rounded-full text-xs btn-primary" style="font-size:10px; letter-spacing:0.05em;">秋</button>
            <button class="h-8 px-4 rounded-full text-xs btn-ghost" style="font-size:10px; letter-spacing:0.05em;">冬</button>
            <button class="h-8 px-4 rounded-full text-xs btn-ghost" style="font-size:10px; letter-spacing:0.05em;">全季</button>
          </div>
        </div>
      </div>
      <div class="flex justify-between mt-6">
        <button onclick="nextStep(1)" class="btn-ghost h-10 px-5 rounded text-xs tracking-widest uppercase">上一步</button>
        <button onclick="nextStep(3)" class="btn-primary h-10 px-6 rounded text-xs tracking-widest uppercase">下一步</button>
      </div>
    </div>

    <!-- Step 3: Confirm (hidden) -->
    <div id="modal-step-3" class="p-6 hidden">
      <p class="text-xs tracking-widest text-cream opacity-30 uppercase mb-4">步驟 3 · 確認並儲存</p>
      <div class="rounded p-4 mb-4" style="background:rgba(47,122,86,0.08); border:1px solid rgba(47,122,86,0.18);">
        <p class="text-xs text-brand-400 mb-2">✨ AI 將自動分析圖片並生成風格標籤</p>
        <p class="text-xs text-cream opacity-30">上傳後 Gemini AI 會分析你的單品圖片，自動標註風格標籤</p>
      </div>
      <div class="flex justify-between mt-6">
        <button onclick="nextStep(2)" class="btn-ghost h-10 px-5 rounded text-xs tracking-widest uppercase">上一步</button>
        <button onclick="closeUploadModal()" class="btn-primary h-10 px-6 rounded text-xs tracking-widest uppercase">儲存單品</button>
      </div>
    </div>

  </div>
</div>


<!-- ═══════════════════════════════════════════════════
     JAVASCRIPT
════════════════════════════════════════════════════ -->
<script>
  const pages = ['login','wardrobe','outfits','recommendations','composer'];

  function showPage(name) {
    pages.forEach(p => {
      const el = document.getElementById('page-' + p);
      if (el) {
        el.classList.remove('active');
        if (p === name) el.classList.add('active');
      }
    });
    const nav = document.getElementById('main-nav');
    nav.classList.toggle('hidden', name === 'login');
    ['wardrobe','outfits','recommendations'].forEach(n => {
      const link = document.getElementById('nav-' + n);
      if (link) link.classList.toggle('active', n === name);
    });
    window.scrollTo(0,0);
  }

  function handleLogin(e) {
    e.preventDefault();
    showPage('wardrobe');
  }

  function openUploadModal() {
    document.getElementById('upload-modal').classList.remove('hidden');
    nextStep(1);
  }

  function closeUploadModal() {
    document.getElementById('upload-modal').classList.add('hidden');
  }

  function nextStep(step) {
    [1,2,3].forEach(s => {
      const el = document.getElementById('modal-step-' + s);
      if (el) el.classList.toggle('hidden', s !== step);
    });
    [0,1,2].forEach(i => {
      const dot = document.getElementById('dot-' + i);
      if (!dot) return;
      dot.classList.remove('active','done');
      if (i < step - 1) dot.classList.add('done');
      else if (i === step - 1) dot.classList.add('active');
    });
  }

  function handleFileSelect(e) {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = ev => {
      document.getElementById('preview-img').src = ev.target.result;
      document.getElementById('preview-container').classList.remove('hidden');
    };
    reader.readAsDataURL(file);
  }

  function clearPreview() {
    document.getElementById('preview-container').classList.add('hidden');
    document.getElementById('preview-img').src = '';
  }

  function toggleComposerItem(el) {
    el.classList.toggle('selected');
  }

  // Auto-navigate via ?page= query param (for screenshot workflow)
  const urlPage = new URLSearchParams(location.search).get('page');
  if (urlPage === 'upload') {
    showPage('wardrobe');
    openUploadModal();
    nextStep(1);
  } else if (urlPage && pages.includes(urlPage)) {
    showPage(urlPage);
  }
</script>
</body>
</html>
