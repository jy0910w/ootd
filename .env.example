# Copy this file to .env and fill in real values.
# 注意：.NET 讀取階層設定需使用雙底線 __ （例如 Cloudinary__CloudName）

# Gemini API settings
Gemini__ApiKey=your_gemini_api_key
Gemini__ModelName=gemini-2.5-flash

# Cloudinary settings (圖片上傳服務)
# 註冊：https://cloudinary.com → Dashboard 取得以下三個值
Cloudinary__CloudName=your_cloud_name
Cloudinary__ApiKey=your_cloudinary_api_key
Cloudinary__ApiSecret=your_cloudinary_api_secret

# Database settings (used by Docker/local tooling)
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=ootd_platform
POSTGRES_PORT=5432

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
